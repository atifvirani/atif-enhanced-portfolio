# ==============================================================================
# ATIF PORTFOLIO BACKEND CONFIGURATION
# Copy this file to .env for local development or set these variables in Render
# ==============================================================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Frontend Origin for CORS enforcement (e.g., your Netlify URL or Render frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# Admin JWT Secret Key (Use a strong random entropy string in production, min 32 chars)
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_minimum_32_characters

# SQLite Storage Persistence on Render (Mount a persistent disk to /var/data and set DATA_DIR)
# DATA_DIR=/var/data
# DB_PATH=/var/data/portfolio.db

# ------------------------------------------------------------------------------
# Nodemailer Contact Form Configuration (Brevo SMTP - Recommended)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_USER=c0a6c9001@smtp-brevo.com
EMAIL_PASS=your_smtp_key_here
EMAIL_FROM=mohammedatif.dev@gmail.com
RECEIVER_EMAIL=mohammedatif.dev@gmail.com

# ------------------------------------------------------------------------------
# Alternative: Gmail SMTP Configuration
# ------------------------------------------------------------------------------
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_verified_gmail_address@gmail.com
# EMAIL_PASS=your_16_character_app_password
# RECEIVER_EMAIL=your_inbox_address@gmail.com
